// TSConfig for the Cloudflare Worker: runs in workerd, not in the browser or Node.js.
{
  "include": ["*.ts"],
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,

    // Runtime and Env types come from worker-configuration.d.ts (generated by `wrangler types`),
    // so no @types/* packages should leak in.
    "types": [],

    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  }
}
