{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npm outdated)",
      "Bash(npm view *)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run preview)",
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(npx vite *)",
      "Bash(npx vitest *)",
      "Bash(npx vue-tsc *)",
      "Bash(npx oxlint *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx create-vite *)",
      "Bash(vitest *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "mcp__context7",
      "mcp__chrome-devtools"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Read(./.dev.vars*)",
      "Edit(./.dev.vars*)",
      "Bash(cat .env*)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(npm deprecate *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout .)",
      "Bash(git branch -D*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/node_modules/*) exit 0;; \"$CLAUDE_PROJECT_DIR\"/*.vue|\"$CLAUDE_PROJECT_DIR\"/*.ts|\"$CLAUDE_PROJECT_DIR\"/*.js|\"$CLAUDE_PROJECT_DIR\"/*.css|\"$CLAUDE_PROJECT_DIR\"/*.json) \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/prettier --write --log-level warn \"$f\" 2>/dev/null || true;; esac",
            "timeout": 30,
            "statusMessage": "Prettier"
          }
        ]
      }
    ]
  }
}
